# ============================================
# NOUROSE REPOSITORY - ENVIRONMENT TEMPLATE
# ============================================
# Copy this file to `.env.live` and fill in the real values.
# `.env.live` is gitignored - never commit the filled-in copy.
#
#   cp .env.example .env.live
#
# Values that are intentionally blank below MUST be provided.

# ============================================
# NEXTAUTH CONFIGURATION
# ============================================
# Generate a fresh one with: openssl rand -base64 32
NEXTAUTH_SECRET=

# ============================================
# GITHUB OAUTH
# ============================================
# Create a GitHub OAuth app (Settings -> Developer settings -> OAuth Apps).
# Authorization callback URL: https://<your-domain>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated list of emails allowed to sign in
AUTHORIZED_EMAILS=

NEXTAUTH_URL="http://localhost:3000"
WHAT_AM_I="0"

# ============================================
# DATABASE
# ============================================
# Development (SQLite):  "file:./dev.db"
# Production:            full connection string, e.g.
#                        "mysql://user:password@host:3306/dbname"
DATABASE_URL="file:./dev.db"

# ============================================
# NEXTJS APP CONFIGURATION
# ============================================
NEXT_APP_HOST="localhost"
NEXT_APP_PORT="3000"
NODE_ENV="development"
# Optional - overrides NEXT_APP_PORT when set
PORT="3000"

# ============================================
# WEBSOCKET SERVER
# ============================================
# Use localhost since Nginx handles external access
WS_SERVER_HOST="localhost"
WS_SERVER_PORT="8080"
# Optional - if unset it is built from host/port/WS_USE_SECURE
WS_SERVER_URL="ws://localhost:8080/ws"
WS_USE_SECURE="false"

# Shared secret for the internal /api/events endpoint and the ws-server.
# Falls back to the insecure default "ingest-123" when unset - always set this.
INTERNAL_SECRET=

# ============================================
# FILE PROCESSING & STORAGE
# ============================================
# Image quality for WebP variants (1-100, lower for bandwidth optimization)
IMAGE_QUALITY="80"
WEBP_QUALITY="75"

# Thumbnail dimensions
THUMB_WIDTH="300"
THUMB_HEIGHT="300"

# Video processing
VIDEO_MAX_BITRATE="3000k"
ENABLE_VIDEO_PROCESSING="true"

# ============================================
# INGEST WATCHER CONFIGURATION
# ============================================
# Watches image_repo/ingest folder for new files
INGEST_FOLDER_PATH="image_repo/ingest"
FILE_STABLE_THRESHOLD="2000"
CONFIG_UPDATE_INTERVAL="10000"
# Number of concurrent ingest workers
INGEST_WORKERS="4"

# Default folder for auto-imported files
DEFAULT_INGEST_FOLDER="LIVE"

# ============================================
# SECURITY & AUTHENTICATION
# ============================================
# Passphrase hashing strength (14 recommended for production)
BCRYPT_ROUNDS="14"

# Rate limiting per minute (per IP)
RATE_LIMIT_PER_MINUTE="50"

# CORS allowed origins
CORS_ORIGINS="http://localhost:3000"

# ============================================
# SOCIAL LINKS & BOOKING
# ============================================
# These are public URLs (NEXT_PUBLIC_ prefix makes them available to client)
NEXT_PUBLIC_BOOKING_LINK="https://example.com/booking"
NEXT_PUBLIC_SOCIAL_INSTAGRAM="https://instagram.com/yourhandle"
NEXT_PUBLIC_SOCIAL_TIKTOK="https://tiktok.com/@yourhandle"
NEXT_PUBLIC_SOCIAL_YOUTUBE="https://youtube.com/@yourhandle"
NEXT_PUBLIC_SOCIAL_WHATSAPP="https://wa.me/10000000000"

# ============================================
# LOGGING & MONITORING
# ============================================
# Production: warn (less noise)
LOG_LEVEL="info"

# Disable SQL logging in production
SQL_LOGGING="false"

# ============================================
# TESTING (optional)
# ============================================
# Base URL used by scripts/test-downloads.js
TEST_BASE_URL="http://localhost:3000"
